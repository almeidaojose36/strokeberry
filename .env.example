# Copy the lines you need into .env.local (git-ignored). Leave a section out to keep that feature off.

# --- Sign-in (Firebase). Without these the studio runs as a single local user. ---
# Web app config from Firebase console → Project settings → Your apps (these are public identifiers, not secrets).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Same project id for the server, which verifies every sign-in token.
FIREBASE_PROJECT_ID=

# --- Payments (Lemon Squeezy, test mode while developing). Without these, Upgrade shows "coming soon". ---
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_PRO_VARIANT_ID=            # Pro monthly ($10)
LEMONSQUEEZY_PRO_YEARLY_VARIANT_ID=     # Pro yearly ($84); the Yearly option shows only when this is set
LEMONSQUEEZY_WEBHOOK_SECRET=
# Prices shown to visitors (the amount charged is whatever the Lemon Squeezy variant says).
STROKEBERRY_PRICE_MONTH=$10
STROKEBERRY_PRICE_YEAR=$84
# "Founding member" offer ($7/month locked, first 100). Set the code only after creating it in Lemon Squeezy:
# a discount with this code, 30% off, duration "forever", 100 redemptions, monthly variant only.
STROKEBERRY_FOUNDER_CODE=
STROKEBERRY_FOUNDER_PRICE=$7
STROKEBERRY_FOUNDER_LIMIT=100

# --- Emails (welcome + "1 video left" / "0 left" notices). Off until these are set. For Zoho: create an app-specific
# password (Zoho Accounts -> Security -> App passwords) and use it here, never your login password. ---
SMTP_HOST=smtp.zoho.com
SMTP_PORT=465
SMTP_USER=hi@strokeberry.com
SMTP_PASSWORD=
SMTP_FROM=Strokeberry <hi@strokeberry.com>

# --- Server ---
# Public address (checkout returns here). Webhook URL to register: <this>/api/billing/webhook
STROKEBERRY_APP_URL=http://127.0.0.1:8001
# Signs private media links. Set a long random value in production (otherwise data/secret.key is used).
STROKEBERRY_SECRET=
# Local testing only: STROKEBERRY_AUTH=dev with STROKEBERRY_DEV_USER=someone shows the signed-in studio as a Free user
# (add STROKEBERRY_DEV_GUEST=1 to see it as a guest).
